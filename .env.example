MEDIA_DIR=./media
DATA_DIR=./data
APP_PORT=8080
APT_MIRROR=repo.huaweicloud.com
DOWNLOAD_DIR=./data/downloads
QBT_CONFIG_DIR=./data/qbittorrent
QBT_IMAGE=dockerproxy.net/qbittorrentofficial/qbittorrent-nox:5.2.3-1
QBT_TORRENT_PORT=6881
# 推荐在 qBittorrent Web UI 中创建 API Key；也可使用用户名/密码回退。
QBT_API_KEY=
QBT_SECRET_DIR=./data/secrets
QBT_API_KEY_FILE=/run/secrets/qbittorrent-api-key
QBT_USERNAME=admin
QBT_PASSWORD=
# 多媒体库可使用一行 JSON 覆盖默认目录，例如：
# MEDIA_LIBRARIES=[{"id":"videos","name":"视频","path":"/media"}]
